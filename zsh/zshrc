# zsh

export PATH=$HOME/.local/bin:/usr/local/bin:$PATH

# Repo root (this file is symlinked from <dotfiles>/zsh/zshrc). ${(%):-%x}
# expands to the path of THIS file; :A resolves symlinks, :h:h goes up two
# levels (zsh/zshrc -> zsh -> repo root), so DOTFILES is the repo root.
# NOTE: this only works because .zshrc is a *symlink*. A plain copy resolves
# to the wrong root and every plugin path below would silently no-op.
export DOTFILES="${DOTFILES:-${${(%):-%x}:A:h:h}}"

######################################################################
# Network zsh plugins (fetched on first use, cached under $ZSH_PLUGINS_DIR)
#   No vendored copies, no plugin manager. Each plugin is a small tarball
#   downloaded from codeload.github.com (which stays reachable even when the
#   git/https endpoint is blocked) and cached once; re-runs are a no-op until
#   the plugin dir is removed. Override the cache root:
#   export ZSH_PLUGINS_DIR=/some/path
######################################################################
export ZSH_PLUGINS_DIR="${ZSH_PLUGINS_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/zsh-plugins}"

# zsh_plugin_fetch <name> <owner/repo> <ref> <entry>
#   Downloads a tarball from codeload.github.com (works when the git/https
#   endpoint is blocked but codeload is reachable). Idempotent: the tarball is
#   only fetched when $ZSH_PLUGINS_DIR/<name> is missing.
#   <owner/repo> e.g. "romkatv/powerlevel10k".
zsh_plugin_fetch() {
  local name="$1" repo="$2" ref="$3" entry="$4"
  local dir="$ZSH_PLUGINS_DIR/$name"
  if [[ ! -f "$dir/$entry" ]]; then
    rm -rf "$dir"
    local tmp tarball
    tmp="$(mktemp -d)"
    tarball="$tmp/$name.tar.gz"
    # Try the requested ref first, then fall back to master/main.
    if ! curl -sL --max-time 30 -o "$tarball" \
        "https://codeload.github.com/$repo/tar.gz/refs/heads/$ref" || \
       ! [[ -s "$tarball" ]]; then
      for _r in master main; do
        curl -sL --max-time 30 -o "$tarball" \
          "https://codeload.github.com/$repo/tar.gz/refs/heads/$_r" && break
      done
    fi
    if tar -tzf "$tarball" >/dev/null 2>&1; then
      mkdir -p "$dir"
      tar -xzf "$tarball" -C "$tmp"
      # The archive has a single top-level dir (owner-or-slug-<ref>); detect
      # it dynamically and move its contents into $dir. Use a glob that keeps
      # dotfiles (.version, .revision-hash, etc.) which `*` alone would skip.
      local top
      top="$(tar -tzf "$tarball" 2>/dev/null | head -1 | cut -d/ -f1)"
      if [[ -n "$top" && -d "$tmp/$top" ]]; then
        setopt LOCAL_OPTIONS
        setopt -s GLOB_DOTS 2>/dev/null || true
        mv "$tmp/$top"/* "$dir/" 2>/dev/null
        unsetopt -s GLOB_DOTS 2>/dev/null || true
      fi
    fi
    rm -rf "$tmp"
  fi
  [[ -f "$dir/$entry" ]] && source "$dir/$entry"
}

# Oh My Zsh (core + git plugin). P10k/theme override ZSH_THEME below.
# Export ZSH explicitly so oh-my-zsh.sh uses our fetched copy and ignores any
# stale ZSH/DOTFILES inherited from the parent environment.
export ZSH="$ZSH_PLUGINS_DIR/oh-my-zsh"
ZSH_DISABLE_COMPFIX=true
DISABLE_AUTO_TITLE="true"
ZSH_THEME=""
plugins=(git)
zsh_plugin_fetch oh-my-zsh ohmyzsh/ohmyzsh master oh-my-zsh.sh

# Autosuggestions.
zsh_plugin_fetch zsh-autosuggestions \
  zsh-users/zsh-autosuggestions master \
  zsh-autosuggestions.plugin.zsh

# Prompt: Starship (brew-managed). Config: config/starship.toml (-> ~/.config/starship.toml).
eval "$(starship init zsh)"

# zsh-syntax-highlighting must be sourced last.
zsh_plugin_fetch zsh-syntax-highlighting \
  zsh-users/zsh-syntax-highlighting master \
  zsh-syntax-highlighting.plugin.zsh
bindkey '^ ' autosuggest-accept
bindkey '^\n' autosuggest-execute

######################################################################
# User configuration
######################################################################
export TERM="xterm-256color"

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_FIND_NO_DUPS HIST_REDUCE_BLANKS

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg-yellow'

# Local X11 default only when not using SSH, Wayland, or an existing DISPLAY.
if [[ -z "$SSH_CONNECTION" && -z "$DISPLAY" && -z "$WAYLAND_DISPLAY" && "$OSTYPE" == linux-* ]]; then
  export DISPLAY=:0.0
fi

######################################################################
# Shared aliases (used by both zsh and bash)
######################################################################
[[ -f "$DOTFILES/zsh/aliases" ]] && source "$DOTFILES/zsh/aliases"

# zsh-only
fg() {
  if [[ $# -eq 1 && $1 = - ]]; then
    builtin fg %-
  else
    builtin fg %"$@"
  fi
}

Cscope() {
  find $(pwd) -type f -name "*.hpp" -o -name "*.cpp" -o -name "*.h" -o -name "*.c" -o -name "*.hh" -o -name "*.cc" > cscope.files
  cscope -bR
}

# Machine-specific env (not in git): see local/env.zsh.example
[[ -f "$DOTFILES/local/env.zsh" ]] && source "$DOTFILES/local/env.zsh"

