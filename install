#!/usr/bin/env bash
# Top-level, self-contained installer (dotbot replacement). Installs missing
# tools, symlinks files into $HOME, installs fonts, and runs post-link hooks.
# A fresh machine that has git + curl can run:  git clone ... && ./install
# Idempotent: a clean re-run does no work and exits ~0 in a few seconds.
#
# Platforms: macOS, Linux, and Windows (run under Git Bash; the script is
# bash-compatible and MSYS2-aware, so it can run in Git Bash without MSYS2
# installed — tool installs on Windows are advisory, see install_pkgs).
#
# Knobs:
#   DRY_RUN=1                print actions, do not modify the filesystem
#   DOTFILES_INSTALL_PKGS=0  skip the package-installation step
set -euo pipefail

DOTFILES="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DOTFILES"

DRY_RUN="${DRY_RUN:-}"
INSTALL_PKGS="${DOTFILES_INSTALL_PKGS:-1}"

# Platform: msys* covers Git Bash (OSTYPE=msys) and MSYS2 (OSTYPE=msys).
# On Windows we never assume a package manager exists — see install_pkgs.
if [[ "${OSTYPE:-}" == msys* || "${OSTYPE:-}" == cygwin* ]]; then
  IS_WINDOWS=1
  # Never let git autocrlf mangle the repo's unix configs to CRLF.
  export GIT_CONFIG_NOSYSTEM=1
else
  IS_WINDOWS=0
fi

c_ok=$'\033[32m'
c_warn=$'\033[33m'
c_err=$'\033[31m'
c_dim=$'\033[2m'
c_off=$'\033[0m'
[[ -t 1 ]] || { c_ok=""; c_warn=""; c_err=""; c_dim=""; c_off=""; }

log()   { printf '%s\n' "$*"; }
info()  { printf '%s%s%s\n' "$c_dim" "$*" "$c_off"; }
ok()    { printf '%sok%s    %s\n' "$c_ok" "$c_off" "$*"; }
warn()  { printf '%swarn%s  %s\n' "$c_warn" "$c_off" "$*" >&2; }
err()   { printf '%serr%s   %s\n' "$c_err" "$*" "$c_off" >&2; }
# Run a command, or just print it under DRY_RUN.
run()   { if [[ -n "$DRY_RUN" ]]; then printf '%s+ %s%s\n' "$c_dim" "$*" "$c_off"; else "$@"; fi; }
# Like run, but only execute when the guard command reports "missing".
# run_if <guard> -- <action-cmd...> ; guard is evaluated with the given
# command (e.g. "command -v python3" or "pip3 show python-argcomplete").
run_if() {
  local g=""; local -a gcmd=() acmd=()
  local arg sep="guard"
  for arg in "$@"; do
    if [[ "$arg" == "--" ]]; then sep="action"; continue; fi
    if [[ "$sep" == guard ]]; then gcmd+=("$arg"); else acmd+=("$arg"); fi
  done
  g="${gcmd[*]}"
  if [[ -n "$DRY_RUN" ]]; then
    local pre
    pre="$( { ${gcmd[@]} || true; } 2>/dev/null )"
    if [[ -n "$pre" ]]; then
      info "missing: $g"
      printf '%s+ %s%s\n' "$c_dim" "${acmd[*]}" "$c_off"
    else
      ok "installed: $g"
    fi
  elif [[ -z "$( { ${gcmd[@]} || true; } 2>/dev/null )" ]]; then
    "${acmd[@]}"
    ok "${acmd[*]}"
  fi
}
# Some brew formulae are keg-only (binary not auto-linked): link the real
# (unversioned) name into the brew bin dir so bare commands resolve.
link_keg() {
  local prefix src dst
  prefix="$(brew --prefix "$1" 2>/dev/null)" || return 0
  src="$prefix/bin/$1"; dst="$(brew --prefix)/bin/$2"
  [[ -f "$src" ]] || return 0
  run ln -sf "$src" "$dst"
  ok "$dst -> $src"
}

# --- Step 1: ensure templated, gitignored files exist -----------------------
if [[ ! -f local/gitconfig.local ]]; then
  info "Creating local/gitconfig.local from template"
  run cp local/gitconfig.local.example local/gitconfig.local
fi

# zshrc.local on Windows is *generated* (MSYS2_PATH is machine-specific); on
# Unix it is copied from the example.  On Windows, only generate it if it is
# missing; if it exists we preserve it (user may have custom entries).
# Emit local/zshrc.local for a Windows/MSYS2 machine.  Detects the common
# per-user tool dirs (scoop, chocolatey, node) and writes MSYS2_PATH entries;
# the rest is boilerplate for the user to extend (proxy / keys / extra PATH).
gen_zshrc_local_windows() {
  local f="local/zshrc.local"
  local scoop_c="$USERPROFILE/scoop/shims" choco_c=""
  local node_c="" windowsapps_c=""
  [[ -d "$USERPROFILE/scoop/shims" ]]  && scoop_c="$USERPROFILE/scoop/shims"
  [[ -d "$USERPROFILE/chocolatey/bin" ]] && choco_c="$USERPROFILE/chocolatey/bin"
  [[ -d "$LOCALAPPDATA/Programs/Python/Python312/Scripts" ]] && node_c=""  # python Scripts — added if it exists
  local d
  for d in "/c/Program Files/nodejs" "/c/Program Files (x86)/nodejs"; do
    [[ -d "$d" ]] && node_c="$d" && break
  done
  if [[ -d "$LOCALAPPDATA/Microsoft/WindowsApps" ]]; then
    windowsapps_c="$LOCALAPPDATA/Microsoft/WindowsApps"
  fi
  local paths=()
  # Order matters: user-managed tools first, then Windows built-ins.
  [[ -n "$scoop_c"     ]] && paths+=("$scoop_c")
  [[ -n "$choco_c"     ]] && paths+=("$choco_c")
  [[ -n "$node_c"      ]] && paths+=("$node_c")
  [[ -n "$windowsapps_c" ]] && paths+=("$windowsapps_c")

  local joined=""
  if (( ${#paths[@]} > 0 )); then
    joined="$(IFS=:; printf '%s' "${paths[*]}")"
  else
    joined="$USERPROFILE/scoop/shims"   # placeholder — user must edit
  fi
  {
    echo "# Auto-generated by ./install on $(date +%Y-%m-%d) — edit freely."
    echo "# Sourced at the end of zsh/zshrc.  Add proxy / API keys / PATH entries below."
    echo
    echo "# Windows PATH entries (MSYS2-style, colon-separated).  Prepended to \$PATH"
    echo "# by zsh/zshrc.  Edit or add entries to taste.  Example:"
    echo "#   export MSYS2_PATH=\"/c/Program Files/nodejs:\$MSYS2_PATH\"   # nodejs"
    echo "#   export MSYS2_PATH=\"\$USERPROFILE/scoop/shims:\$MSYS2_PATH\" # scoop"
    echo "export MSYS2_PATH=\"${joined}\""
    echo
    echo "# Proxy (if needed)"
    echo "# export HTTP_PROXY=http://127.0.0.1:7890"
    echo "# export HTTPS_PROXY=\"\$HTTP_PROXY\""
    echo "# export NO_PROXY=localhost,127.0.0.1"
  } > "$f"
}

if [[ $IS_WINDOWS -eq 1 ]]; then
  if [[ ! -f local/zshrc.local ]]; then
    info "Creating local/zshrc.local (Windows/MSYS2 version)"
    run gen_zshrc_local_windows
  else
    ok "local/zshrc.local (existing)"
  fi
else
  if [[ ! -f local/zshrc.local ]]; then
    info "Creating local/zshrc.local from template (edit for proxy/PATH/keys)"
    run cp local/zshrc.local.example local/zshrc.local
  fi
fi

# --- Step 2: install missing packages ---------------------------------------
# Tools referenced by this repo:
#   git zsh tmux starship eza ripgrep ctags node python
# Plus the Python deps local/zshrc.local.example relies on.
BREW_FORMULAS=(git zsh tmux starship eza ripgrep ctags node python@3.15)
BREW_TAPS=(rapid-mlx)
APT_PACKAGES=(git zsh tmux eza ripgrep ctags nodejs npm python3 python3-pip)
# Windows (pacman / MSYS2): binary names checked with `command -v`; the
# pacman package names happen to match these for the current MSYS2 repos
# (node and python3 have shims; starship *is* in pacman these days).  If a
# newer MSYS2 renames one of these, pacman will simply fail on that name and
# the checklist branch above covers the rest.
WIN_PKGS=(git zsh tmux eza ripgrep ctags node python3 starship)
# Plus the Python deps local/zshrc.local.example relies on (user-level, no sudo).
PIP_PACKAGES=(argcomplete)

install_pkgs() {
  local os; os="$(uname -s)"

  # --- Windows ----------------------------------------------------------
  # There is no canonical Windows package manager; we never install anything
  # system-wide here.  If MSYS2 is present we can ask for its packages; if
  # Git Bash alone, we print a manual checklist and let the user pick.
  if [[ $IS_WINDOWS -eq 1 ]]; then
    if command -v pacman >/dev/null 2>&1; then
      local pkg missing=()
      for pkg in "${WIN_PKGS[@]}"; do
        command -v "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
      done
      if (( ${#missing[@]} > 0 )); then
        info "pacman: installing ${missing[*]}"
        run pacman -S --noconfirm --needed "${missing[@]}"
        ok "pacman: ${missing[*]}"
      else
        ok "pacman: all packages present"
      fi
    else
      warn "Windows: no pacman (MSYS2) found — print manual checklist, do not install anything"
      cat <<'CHECKLIST'
  To install tools on Windows, do one of:

    A. Install MSYS2 (msys2.org), then re-run ./install  (pacman will pick them up)
    B. Use scoop  (scoop.sh):  scoop install git tmux starship ripgrep ctags node
    C. Install individually:  git-scm.com, tmux (MSYS2 only), starship (scoop or cargo)

  Minimum for the dotfiles to work on Windows:  git, zsh (from MSYS2 or Git for Windows), starship
CHECKLIST
    fi
    # pip step (only if python is on PATH; pip on Windows varies by source)
    local pybin=""
    command -v python3 >/dev/null 2>&1 && pybin="python3"
    [[ -z "$pybin" ]] && command -v python  >/dev/null 2>&1 && pybin="python"
    if [[ -n "$pybin" ]]; then
      for p in "${PIP_PACKAGES[@]}"; do
        run_if $pybin -m pip show "$p" -- $pybin -m pip install --user "$p"
      done
    else
      info "python not on PATH; skipping pip packages (${PIP_PACKAGES[*]})"
    fi
    return 0
  fi

  if [[ $IS_WINDOWS -eq 1 ]]; then
    : # handled in the Windows branch above
  elif [[ "$os" == "Darwin" ]]; then
    if ! command -v brew >/dev/null 2>&1; then
      info "Homebrew not found; installing (needs sudo for CLT)"
      # Official installer; --quiet. Skipped entirely under DRY_RUN.
      if [[ -n "$DRY_RUN" ]]; then
        printf '%s+ %s%s\n' "$c_dim" "/bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\" --quiet" "$c_off"
      else
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" --quiet
        ok "Homebrew"
      fi
      # Wire brew into this shell's PATH (official post-install steps).
      if [[ -x /opt/homebrew/bin/brew ]]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
      elif [[ -x /usr/local/bin/brew ]]; then
        eval "$(/usr/local/bin/brew shellenv)"
      fi
      command -v brew >/dev/null 2>&1 || { warn "brew still not on PATH; skipping package install (run the 'Next steps' it printed)"; return 0; }
    fi
    local f t missing=()
    for f in "${BREW_FORMULAS[@]}"; do
      command -v "$f" >/dev/null 2>&1 || missing+=("$f")
    done
    for t in "${BREW_TAPS[@]}"; do
      run_if brew list --formula "$t" -- brew install "$t"
    done
    if (( ${#missing[@]} > 0 )); then
      info "brew: installing ${missing[*]}"
      run brew install "${missing[@]}"
      ok "brew: ${missing[*]}"
    else
      ok "brew: all formulas present"
    fi
    # Keep unversioned names working for keg-only formulae (brew does not
    # auto-link them): python@3.15 -> python3, node is fine, etc.
    link_keg python@3.15 python3
  else
    # Linux: use the distro package manager when available (Debian/Ubuntu/RHEL).
    local pm=""
    if command -v apt-get >/dev/null 2>&1; then
      pm="apt"
    elif command -v dnf >/dev/null 2>&1; then
      pm="dnf"
    elif command -v yum >/dev/null 2>&1; then
      pm="yum"
    fi
    if [[ -n "$pm" ]]; then
      local SUDO="" pkg missing=()
      [[ $(id -u) -ne 0 ]] && SUDO="sudo"
      if [[ -z "$DRY_RUN" && -n "$SUDO" ]] && command -v sudo >/dev/null 2>&1; then
        warn "package manager needs root; step will run via sudo"
      fi
      for pkg in "${APT_PACKAGES[@]}"; do
        command -v "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
      done
      # ctags has a different name on RHEL.
      if [[ "$pm" == dnf || "$pm" == yum ]]; then
        command -v ctags >/dev/null 2>&1 || missing+=("ctags")
      fi
      if (( ${#missing[@]} > 0 )); then
        info "$pm: installing ${missing[*]}"
        case "$pm" in
          apt)  run $SUDO apt-get install -y "${missing[@]}" ;;
          *)    run $SUDO "$pm" install -y "${missing[@]}" ;;
        esac
        ok "$pm: ${missing[*]}"
      else
        ok "$pm: all packages present"
      fi
    else
      warn "no known package manager (apt/dnf/yum); skipping: ${APT_PACKAGES[*]}"
    fi
  fi

  # Python deps used by local/zshrc.local.example (user-level, no sudo).
  # Only on Unix — the Windows branch above handles its own pip step.
  if [[ $IS_WINDOWS -eq 0 ]]; then
    if command -v pip3 >/dev/null 2>&1; then
      for p in "${PIP_PACKAGES[@]}"; do
        if pip3 show "$p" >/dev/null 2>&1; then
          ok "pip: $p"
        else
          info "pip: installing $p"
          run pip3 install --user --break-system-packages "$p"
          ok "pip: $p"
        fi
      done
    else
      info "pip3 not found; skipping pip packages (${PIP_PACKAGES[*]}) — install python first"
    fi
  fi
}

[[ "$INSTALL_PKGS" == 1 ]] && install_pkgs || info "Skipping package install (DOTFILES_INSTALL_PKGS=0)"

# --- Step 3: clean broken symlinks at the top level of $HOME ----------------
# Windows note: real symlinks require dev-mode or admin; the link() helper
# below silently degrades to *copy + a .dotfiles-copied marker file* when
# `ln -s` fails, so this broken-symlink sweep is a no-op on Windows in the
# common case (no symlinks were made) and still cleans up stale ones.
shopt -s dotglob nullglob
for f in "$HOME"/.[!.]*; do
  if [[ -L "$f" && ! -e "$f" ]]; then
    info "Removing broken symlink: $f"
    run rm -f "$f"
  fi
  # Stale copy markers (only on Windows) — file existed, we replaced it,
  # and the user later deleted the source dotfile; remove the marker too.
  if [[ $IS_WINDOWS -eq 1 && -f "$f.dotfiles-copied" ]]; then
    info "Removing stale marker: $f.dotfiles-copied"
    run rm -f "$f.dotfiles-copied"
  fi
done
shopt -u dotglob nullglob

# --- Step 4: link config files into $HOME -----------------------------------
# Usage: link <source-relative-to-$DOTFILES> <target-absolute> [force]
#   force: if target exists and is NOT already the desired symlink, replace
#          it (no automatic backup; back up by hand if you care).
#
# On Windows, real symlinks require developer mode / admin; when `ln -s`
# fails we fall back to *copying* the source into $HOME (for directories,
# recursively) and leave a <dst>.dotfiles-copied marker noting the source.
# Re-runs of install will refresh the copy (no drift) until the marker is
# removed.  Set DOTFILES_SYMLINK=1 to force symlink creation and fail hard
# when the OS refuses.
link() {
  local src="$1" dst="$2" flags="${3:-}"
  local abs="$DOTFILES/$src"
  if [[ ! -e "$abs" ]]; then
    err "missing source: $src"
    return 1
  fi
  run mkdir -p "$(dirname "$dst")"
  if [[ -L "$dst" ]]; then
    if [[ "$(readlink "$dst")" == "$abs" ]]; then
      ok "$dst"
      return 0
    fi
    run rm -f "$dst"
  elif [[ -e "$dst" ]]; then
    # A copied file left over from a prior install?  Compare content and
    # refresh if it has drifted; otherwise leave it be.
    local marker="${dst}.dotfiles-copied"
    if [[ $IS_WINDOWS -eq 1 && -f "$marker" ]]; then
      if diff -qr "$abs" "$dst" >/dev/null 2>&1 || ! [[ -e "$abs" ]]; then
        ok "$dst (copied, up to date)"
        return 0
      fi
      info "Refreshing stale copy: $dst"
      run rm -rf "$dst"
    elif [[ "$flags" == *force* ]]; then
      warn "replacing existing $dst (force)"
      run rm -rf "$dst"
    else
      err "exists and not a symlink/copy: $dst (use 'force' or remove it manually)"
      return 1
    fi
  fi
  # Try a real symlink first; fall back to copy on Windows if the OS refuses.
  local mode="symlink"
  if ! run ln -s "$abs" "$dst" 2>/dev/null; then
    if [[ $IS_WINDOWS -eq 1 && "${DOTFILES_SYMLINK:-0}" != "1" ]]; then
      info "ln -s failed on Windows; falling back to copy (DOTFILES_SYMLINK=1 to force symlink)"
      run cp -r "$abs" "$dst" 2>/dev/null || run cp "$abs" "$dst"
      printf '%s' "$abs" > "${dst}.dotfiles-copied" 2>/dev/null || true
      mode="copy"
    else
      err "could not create link $dst -> $abs"
      return 1
    fi
  fi
  if [[ "$mode" == symlink ]]; then
    ok "$dst -> $abs"
  else
    ok "$dst (copied from $abs; remove ${dst}.dotfiles-copied to re-symlink)"
  fi
}

# Windows: the .zshrc is a *file* sourced by zsh, but on Windows zsh reads
# from $HOME/.zshrc — same path, but we must *copy* (not symlink) for the
# DOTFILES resolution in zsh/zshrc to work correctly when the user is in a
# directory whose path differs.  Symlinks also work when dev-mode is on;
# link() handles the fallback automatically.
if [[ $IS_WINDOWS -eq 1 ]]; then
  # Windows target dir for user config (no ~/.config by convention; but
  # starship reads XDG_CONFIG_HOME on MSYS2, which defaults to ~/.config).
  export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
fi

link agents                   "$HOME/.agents"
link tmux.conf                "$HOME/.tmux.conf"
link vimrc                    "$HOME/.vimrc"
link vim                      "$HOME/.vim"
link zshrc                    "$HOME/.zshrc"
link local/zshrc.local        "$HOME/.zshrc.local"
link bashrc                   "$HOME/.bashrc"               force
link config/starship.toml     "${XDG_CONFIG_HOME:-$HOME/.config}/starship.toml"
link git/gitconfig            "$HOME/.gitconfig"
link local/gitconfig.local    "$HOME/.gitconfig.local"      force
link git/gitignore_global     "$HOME/.gitignore_global"

# --- Step 5: install fonts ---------------------------------------------------
# Copies bundled fonts (e.g. MapleMono Nerd Font) into the user font directory:
# macOS ~/Library/Fonts, Linux ~/.local/share/fonts (+ fontconfig cache rebuild).
install_fonts() {
  local src="$1"
  if [[ ! -d "$src" ]]; then
    ok "No fonts bundled; skipping"
    return 0
  fi
  local dst
  if [[ $(uname) == "Darwin" ]]; then
    dst="$HOME/Library/Fonts"
  elif [[ $IS_WINDOWS -eq 1 ]]; then
    # Windows: per-user font dir.  Terminal emulators (Windows Terminal,
  # Alacritty, wezterm) read this directory directly; no registry refresh.
  dst="${LOCALAPPDATA:-$HOME}/Microsoft/Windows/Fonts"
  else
    dst="${XDG_DATA_HOME:-$HOME/.local/share}/fonts"
  fi
  local f base count=0
  for f in "$src"/*; do
    [[ -f "$f" ]] || continue
    base="$(basename "$f")"
    if [[ -f "$dst/$base" ]]; then
      ok "$dst/$base"
      continue
    fi
    info "Installing font: $base"
    run mkdir -p "$dst"
    run cp "$f" "$dst/$base"
    count=$((count + 1))
  done
  if [[ "$count" -gt 0 ]]; then
    if [[ $(uname) == "Darwin" ]]; then
      run system_profiler SPFontsDataType >/dev/null 2>&1 || true  # nudge macOS to rescan
    elif [[ $IS_WINDOWS -eq 1 ]]; then
      # No fc-cache on Windows; the per-user dir is picked up by the font
      # subsystem on next use.  We just print a reminder.
      info "Fonts installed.  Select 'Maple Mono' in your terminal (Windows Terminal / Alacritty / wezterm)."
    else
      run fc-cache -f "$dst" 2>/dev/null || true
    fi
  fi
  ok "Fonts -> $dst"
}

install_fonts "$DOTFILES/fonts"

# --- Step 6: post-link hooks -------------------------------------------------
info "Creating Vim cache directories"
run mkdir -p "$HOME/.cache/vim/plugged"

echo
ok "All tasks completed."
if [[ $IS_WINDOWS -eq 1 ]]; then
  info "Next:"
  info "  * Open Git Bash and run:  exec zsh     (zsh comes from MSYS2; skip if you didn't install it)"
  info "  * starship / tmux / eza / ripgrep:  see the checklist ./install printed when pacman was absent"
  info "  * Edit local/gitconfig.local (git identity) and local/zshrc.local (proxy/PATH/keys)"
  info "  * If you want true symlinks (no copies): enable Windows 'developer mode' in Settings,"
  info "    re-run ./install with DOTFILES_SYMLINK=1, then remove the .dotfiles-copied markers."
else
  info "New shell session:  exec zsh"
  info "Edit local/zshrc.local (proxy/PATH/keys) and local/gitconfig.local (git identity) if needed."
fi
