# Copy to zshrc.local (ignored by git):  cp local/zshrc.local.example local/zshrc.local
# Sourced at the end of zsh/zshrc — use for proxy, PATH, API keys, DISPLAY, etc.
#
# On Windows (Git Bash / MSYS2) the install script auto-generates a
# zshrc.local with a sane MSYS2 PATH; this example is the manual reference.

# export HTTP_PROXY=http://127.0.0.1:7890
# export HTTPS_PROXY="$HTTP_PROXY"
# export PATH="/opt/custom/bin:$PATH"

# --- Windows / MSYS2 (zshrc.local is generated by install; reference only) ---
# export MSYS2_PATH="/c/Users/<user>/scoop/shims:$PATH"
# export MSYS2_PATH="/c/Program Files/nodejs:$MSYS2_PATH"
# export MSYS2_PATH="/c/Program Files/WindowsApps:$MSYS2_PATH"   # powershell
# export PATH="$HOME/.local/share/solaar:$PATH"                  # hidapi device tools
